# Copy to .env (git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default, most accurate) | claude-sonnet-5-5 (half the price) | claude-haiku-5-5 (cheapest)
VLM_MODEL=claude-opus-5-5
# low | medium | high  (how much the model thinks; higher = slower and more tokens)
VLM_EFFORT=medium
VLM_TIMEOUT_SECONDS=120
OCR_LANG=en
OCR_ENABLE_MKLDNN=0
